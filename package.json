{
  "name": "hlovet-hub",
  "private": true,
  "version": "0.1.0",
  "description": "HLOVET Hub personal portal platform",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @hlovet/api --filter @hlovet/web dev",
    "build": "pnpm --filter @hlovet/api build && pnpm --filter @hlovet/web build",
    "lint": "pnpm --filter @hlovet/api lint && pnpm --filter @hlovet/web lint",
    "test": "pnpm --filter @hlovet/api test",
    "p21:load-test": "node scripts/p21-load-test.mjs",
    "p22:release-check": "node scripts/p22-release-check.mjs",
    "p22:browser-smoke": "python scripts/p22-browser-smoke.py",
    "format": "pnpm --filter @hlovet/api format && pnpm --filter @hlovet/web format"
  }
}
